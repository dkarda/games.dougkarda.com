VITE_DATA_BASE_URL=https://assets.dougkarda.com/data/
VITE_IMG_BASE_URL=https://assets.dougkarda.com/images/

# RAWG API key from https://rawg.io/apidocs (required for /videogames)
VITE_RAWG_API_KEY=

# RAWG profile slug whose game list is merged with the CDN library
VITE_RAWG_USERNAME=

# Optional override; defaults to the CDN list below
VITE_VIDEOGAMES_JSON_URL=https://assets.dougkarda.com/data/videogames.json
